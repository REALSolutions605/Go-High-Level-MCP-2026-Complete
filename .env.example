# ── Deployment ────────────────────────────────────────────────────────────────
# Production host for this project (Railway auto-deploys `main`):
#   https://ghlmcp.real-solutions-llc.com
# See CLOUD-DEPLOYMENT.md for the endpoint list and how to verify a deploy
# against the commit SHA reported by /health.

# GoHighLevel API Configuration
GHL_API_KEY=your_private_integration_api_key_here
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_LOCATION_ID=your_location_id_here

# Server Configuration
MCP_SERVER_PORT=8000
NODE_ENV=development

# Optional: bearer token guarding /mcp, /sse and /tools/call.
# Unset means those routes are open.
MCP_BEARER_TOKEN=

# ── Pre-Analysis Engine (PAE-W2) ──────────────────────────────────────────────
# /pae/analyze validates, acknowledges within a second, then runs the analysis
# and writes the result onto the OPPORTUNITY as paew2_* custom fields. It never
# returns a verdict in the HTTP response — GHL's custom-webhook action times out
# long before a 27-38s analysis finishes.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PAE_WEBHOOK_SECRET=shared_secret_sent_as_x_pae_secret_header

# Optional PAE tuning
# PAE_MAX_PROFILES=8
# PAE_PROFILE_CACHE_TTL_MS=600000
# PAE_PROFILE_FETCH_TIMEOUT_MS=8000
# PAE_WRITEBACK_TIMEOUT_MS=15000
# PAE_WRITEBACK_FIELD_CACHE_TTL_MS=600000

# COMMS-W1 verified send. Falls back to PAE_WEBHOOK_SECRET when unset.
# COMMS_WEBHOOK_SECRET=

# ── Build identity ────────────────────────────────────────────────────────────
# Railway injects RAILWAY_GIT_COMMIT_SHA automatically; /health reports it so a
# deploy can be verified rather than assumed. Set one of these manually only if
# the platform does not provide it.
# GIT_COMMIT_SHA=

# Optional: For AI features
OPENAI_API_KEY=your_openai_key_here_optional
